# Optional. Without it, summaries fall back to a rule-based template.
ANTHROPIC_API_KEY=
# Optional overrides: force the rule-based summary, or change the model.
# SUMMARY_MODE=rules
# SUMMARY_MODEL=claude-opus-5-5

# api.weather.gov requires a User-Agent identifying the app + a contact.
NWS_USER_AGENT=travel-disruption-radar (contact@example.com)
